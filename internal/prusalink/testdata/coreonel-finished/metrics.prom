prusa_temperature_target_celsius{printer_address="PRINTER",printer_heated_element="bed",printer_model="COREONEL",printer_name="Test"} 0
prusa_temperature_target_celsius{printer_address="PRINTER",printer_heated_element="tool0",printer_model="COREONEL",printer_name="Test"} 0
