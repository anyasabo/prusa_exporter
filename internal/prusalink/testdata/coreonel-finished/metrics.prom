# TYPE prusa_udp_metrics_gcode_sent gauge
prusa_udp_metrics_gcode_sent{printer_address="PRINTER",printer_model="COREONEL",printer_name="Test"} 0
# HELP prusa_up 1 if all PrusaLink requests of the scrape succeeded, else 0.
# TYPE prusa_up gauge
prusa_up{printer_address="PRINTER",printer_model="COREONEL",printer_name="Test"} 1
