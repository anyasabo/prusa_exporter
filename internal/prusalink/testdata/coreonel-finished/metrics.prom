# TYPE prusa_temperature_celsius gauge
prusa_temperature_celsius{printer_address="PRINTER",printer_heated_element="bed",printer_model="COREONEL",printer_name="Test"} 30.8
prusa_temperature_celsius{printer_address="PRINTER",printer_heated_element="tool0",printer_model="COREONEL",printer_name="Test"} 29.4
# HELP prusa_temperature_target_celsius Target temperature of a heated element.
